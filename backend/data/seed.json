  "interactions": [
    {"ingredient_id":"pimozide","severity":"contraindicated","effect":"QT延長、心室性不整脈などの重篤な心血管系副作用が生じるおそれがあります。","mechanism":"クラリスロマイシンによるCYP3A阻害でピモジドの血中濃度が上昇します。","action":"併用しないでください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"suvorexant","severity":"contraindicated","effect":"スボレキサントの作用が著しく増強し、過度の傾眠等が生じるおそれがあります。","mechanism":"強いCYP3A阻害によりスボレキサントの代謝が阻害されます。","action":"併用しないでください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"ergotamine","severity":"contraindicated","effect":"四肢虚血などの麦角中毒を生じるおそれがあります。","mechanism":"CYP3A阻害により麦角アルカロイドの血中濃度が上昇します。","action":"併用しないでください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"warfarin","severity":"caution","effect":"抗凝固作用が増強し、出血リスクが高まることがあります。","mechanism":"代謝阻害や腸内細菌叢への影響等によりワルファリン作用が増強する可能性があります。","action":"INR等を確認し、必要に応じて用量を調整してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"digoxin","severity":"caution","effect":"ジゴキシンの血中濃度が上昇し、中毒症状が生じることがあります。","mechanism":"腸内細菌叢やP糖蛋白への影響により吸収・排泄が変化する可能性があります。","action":"血中濃度や徐脈、悪心等を観察してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"carbamazepine","severity":"caution","effect":"カルバマゼピンの血中濃度上昇による中毒症状が生じることがあります。","mechanism":"CYP3A阻害によりカルバマゼピンの代謝が抑制されます。","action":"血中濃度と神経症状を観察し、必要に応じて減量してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"theophylline","severity":"caution","effect":"テオフィリンの血中濃度が上昇することがあります。","mechanism":"代謝阻害によりクリアランスが低下する可能性があります。","action":"血中濃度や悪心、振戦、頻脈等を観察してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"midazolam","severity":"caution","effect":"鎮静作用や呼吸抑制が増強するおそれがあります。","mechanism":"CYP3A阻害によりミダゾラムの代謝が抑制されます。","action":"投与量を検討し、呼吸・意識状態を十分に観察してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"tacrolimus","severity":"caution","effect":"タクロリムスの血中濃度が上昇し、腎障害等の毒性が増強することがあります。","mechanism":"CYP3A阻害によりタクロリムスの代謝が抑制されます。","action":"血中濃度を測定し、必要に応じて用量を調整してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"cyclosporine","severity":"caution","effect":"シクロスポリンの血中濃度が上昇し、腎障害等が生じることがあります。","mechanism":"CYP3A阻害によりシクロスポリンの代謝が抑制されます。","action":"血中濃度と腎機能を観察し、必要に応じて用量を調整してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"atorvastatin","severity":"caution","effect":"アトルバスタチンの血中濃度が上昇し、筋障害のリスクが高まることがあります。","mechanism":"CYP3A阻害によりアトルバスタチンの代謝が抑制されます。","action":"必要性を再評価し、筋症状やCK上昇を観察してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true},
    {"ingredient_id":"fexofenadine","severity":"caution","effect":"フェキソフェナジンの血中濃度が上昇することがあります。","mechanism":"輸送体への影響により薬物動態が変化する可能性があります。","action":"副作用の発現に注意してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true}
    ,{"ingredient_id":"lemborexant","severity":"caution","effect":"レンボレキサントの血中濃度が上昇し、傾眠等の副作用が増強するおそれがあります。","mechanism":"クラリスロマイシンによるCYP3A阻害でレンボレキサントの代謝が阻害されます。","action":"患者の状態を慎重に観察し、レンボレキサントの用量を含め最新の電子添文に従って対応してください。","source_url":"https://www.pmda.go.jp/PmdaSearch/iyakuSearch/","source_revision":"2026-06-12確認用シード","verified":true}
