{
  "manifest_version": 3,
  "name": "くらりす - 薬剤相互作用チェッカー",
  "version": "0.1.0",
  "description": "くすりの、らくな、リスクスクリーニング。代表20成分との相互作用をローカルDBで確認します。",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "くらりすで相互作用を確認",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765"
  }
}
